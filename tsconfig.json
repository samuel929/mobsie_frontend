{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "admin-dashboard",
    "mobsie-control-centre-editable",
    "mobsie-control-centre-editable-v2",
    "mobsie-control-centre-integrated",
    "outputs",
    "node_modules"
  ]
}
