{
  "expo": {
    "name": "Mobsie Connect",
    "slug": "mobsie-connect",
    "scheme": "mobsieconnect",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fd85a855-ce49-4734-b3f3-25e40271c25c"
    },
    "orientation": "portrait",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/clean/favicon.png",
        "backgroundColor": "#F8F4EC"
      },
      "package": "co.mobsie.connect"
    },
    "icon": "./assets/clean/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/clean/favicon.png",
      "bundleIdentifier": "co.mobsie.connect",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/clean/notification-icon.png",
          "color": "#008D85"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mobsie Connect to access photos for application document uploads.",
          "cameraPermission": "Allow Mobsie Connect to take photos for application document uploads."
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/clean/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F4EC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd85a855-ce49-4734-b3f3-25e40271c25c"
      }
    },
    "owner": "samuel44"
  }
}
